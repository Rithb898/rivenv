{
	"name": "rivenv",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.4.0",
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@better-auth/drizzle-adapter": "^1.7.4",
		"@daypicker/react": "^10.0.1",
		"@vinext/cloudflare": "latest",
		"better-auth": "^1.7.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.3.0",
		"drizzle-orm": "^1.0.0-rc.4",
		"lucide-react": "^1.45.0",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"tailwind-merge": "^3.6.0",
		"vinext": "latest"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "latest",
		"@tailwindcss/postcss": "latest",
		"@types/node": "^22.20.2",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"drizzle-kit": "^1.0.0-rc.4",
		"tailwindcss": "latest",
		"tw-animate-css": "^1.4.0",
		"typescript": "latest",
		"vite": "latest",
		"wrangler": "^4.131.1"
	},
	"type": "module",
	"scripts": {
		"dev": "vinext dev",
		"build": "vinext build",
		"start": "wrangler dev --config dist/server/wrangler.json",
		"deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
		"preview": "bun run build && bun run start",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "wrangler d1 migrations apply rivenv --local",
		"db:migrate:prod": "wrangler d1 migrations apply rivenv --remote",
		"db:execute": "wrangler d1 execute rivenv --local",
		"db:execute:prod": "wrangler d1 execute rivenv --remote"
	}
}